{
  "name": "immersa-presentations",
  "version": "0.1.0",
  "description": "Synchronized web presentation MVP for Immersa Presentations.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "migrate": "npm run db:migrate && npm run auth:migrate",
    "db:migrate": "node scripts/migrate-db.js",
    "auth:migrate": "node auth/migrate-auth-v1.mjs",
    "auth-spike:migrate": "node auth/migrate-compatibility-spike.mjs",
    "backup:decks": "node scripts/backup-decks.js",
    "flush:test-decks": "node scripts/flush-test-decks.js",
    "flush:decks": "node scripts/flush-decks.js",
    "local:import-event": "node scripts/import-local-event-package.js"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.4",
    "socket.io": "^4.7.5",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
