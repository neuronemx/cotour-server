# IMMERSA Local / Offline v1
# Copy this file to .env.local-demo and replace every value marked CHANGE_ME.

# Server
PORT=8080
IMMERSA_LOCAL_PORT=3000
IMMERSA_MODE=local-demo
IMMERSA_DATA_DIR=/data
IMMERSA_ROUTE_GUARD_SECRET=CHANGE_ME_generate_a_long_random_local_secret

# Local MariaDB (the host name is the Docker Compose service name)
IMMERSA_MYSQL_HOST=mariadb
IMMERSA_MYSQL_PORT=3306
IMMERSA_MYSQL_DATABASE=immersa_local
IMMERSA_MYSQL_USER=immersa
IMMERSA_MYSQL_PASSWORD=CHANGE_ME_local_app_password
IMMERSA_MYSQL_CONNECTION_LIMIT=20

# MariaDB container initialization
MARIADB_DATABASE=immersa_local
MARIADB_USER=immersa
MARIADB_PASSWORD=CHANGE_ME_local_app_password
MARIADB_ROOT_PASSWORD=CHANGE_ME_different_long_local_root_password

# Demo capabilities
IMMERSA_QNA_ENABLED=true
IMMERSA_KNOWLEDGE_ACTIVITIES_ENABLED=true

# Explicitly off in the offline installation
IMMERSA_AUTH_ENABLED=false
IMMERSA_AUTH_SPIKE_ENABLED=false
IMMERSA_BILLING_ENABLED=false
IMMERSA_BILLING_CHECKOUT_ENABLED=false
